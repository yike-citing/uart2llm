{
  "openapi": "3.0.3",
  "info": {
    "title": "uart2llm management API",
    "version": "1.0.0",
    "description": "Loopback only. Browser requests must match Host/Origin; tokens and secret settings are never returned implicitly."
  },
  "servers": [
    {
      "url": "http://localhost:8766"
    }
  ],
  "paths": {
    "/admin/v1/session": {
      "post": {
        "summary": "Automatically create a passwordless local browser session",
        "operationId": "post_session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation or device operation failed"
          },
          "403": {
            "description": "Origin or Host rejected"
          },
          "409": {
            "description": "Conflicting maintenance/transaction"
          },
          "415": {
            "description": "application/json required"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "token": {
                    "type": "string",
                    "deprecated": true,
                    "description": "Ignored compatibility field; omit for passwordless access."
                  }
                }
              }
            }
          }
        },
        "description": "Same-origin application/json POST with {}. No password or token input required. HttpOnly SameSite=Strict cookie expires after eight hours. Invalid Host, Origin or cross-site Fetch Metadata is rejected."
      },
      "delete": {
        "summary": "End browser session",
        "operationId": "delete_session",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Validation or device operation failed"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Origin or Host rejected"
          },
          "409": {
            "description": "Conflicting maintenance/transaction"
          }
        },
        "security": [
          {
            "bearerAuth": []
          },
          {
            "browserSession": []
          }
        ]
      }
    },
